# ---------------------------------------------------------------------------
# TaxHub — environment template.  Copy to .env and fill in.
# NEVER commit .env — it is listed in .gitignore.
# ---------------------------------------------------------------------------

# Supabase Postgres, pgvector enabled.
# Use the POOLED connection string (port 6543) for the app.
# Use the DIRECT connection string (port 5432) for migrations if pooling blocks DDL.
DATABASE_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres"

# Answer generation — Anthropic (Claude). Replaces the starter's OpenAI default.
ANTHROPIC_API_KEY="sk-ant-..."

# Embeddings — OpenAI text-embedding-3-large (multilingual).
OPENAI_API_KEY="sk-..."

# Optional. Only needed if lib/ai/config.ts is switched to Cohere
# embed-multilingual-v3.0 (see the commented switch in that file).
# COHERE_API_KEY=""
